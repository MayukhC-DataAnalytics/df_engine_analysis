# ============================================================================
# TEMPLATE ONLY -- do not fill in real values here or commit a real
# secrets.toml to git. This file exists so you (or anyone forking this repo)
# knows exactly what keys the app expects.
#
# LOCAL USE: copy this file to .streamlit/secrets.toml (same folder) and
# fill in real values. .streamlit/secrets.toml is already in .gitignore.
#
# STREAMLIT COMMUNITY CLOUD USE: do NOT upload a secrets.toml file at all.
# Instead, open your app on share.streamlit.io -> Settings -> Secrets, and
# paste the contents below (with real values) into that box. Streamlit
# injects it as st.secrets at runtime; it is never stored in your repo.
# ============================================================================

[databricks]
# SQL Warehouse "Connection details" tab -> Server hostname
host = "xxxx.cloud.databricks.com"

# SQL Warehouse "Connection details" tab -> HTTP path
http_path = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"

# Profile icon -> Settings -> Developer -> Access tokens -> Generate new token
# Use a token with READ-ONLY access to the df_project catalog if your
# Databricks admin can scope it that tightly -- this app never writes data.
token = "dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# The catalog and schema this project's dbt models were built into.
catalog = "df_project"
schema = "mart"

# ----------------------------------------------------------------------------
# OPTIONAL: only needed for the "🤖 Explain this in plain English" buttons.
# Without this section, the rest of the dashboard works normally -- clicking
# an explain button just shows a friendly reminder to add this key.
# ----------------------------------------------------------------------------
[anthropic]
# console.anthropic.com -> Settings -> API Keys -> Create Key
api_key = "sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
